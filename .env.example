# Copy to .env for local development (.env is git-ignored).
DATABASE_URL=postgres://divehub:divehub-dev@127.0.0.1:5432/divehub
# Optional: the PostgreSQL server for tests and browser tests (their throwaway databases). When unset, they use the
# local development default. Never point this at the database above unless creating and dropping databases there is safe.
# DIVEHUB_TEST_DATABASE_URL=postgres://divehub:divehub-dev@127.0.0.1:5432/divehub
DIVEHUB_DATA_DIR=./data
DIVEHUB_PORT=3000
# Public URL users open; invitation links point here. The Vite dev server is on 5173.
DIVEHUB_BASE_URL=http://localhost:5173
# Optional: cookie signing secret (otherwise generated into DIVEHUB_DATA_DIR/auth-secret).
# DIVEHUB_AUTH_SECRET=
# Optional: log level (fatal, error, warn, info, debug, trace).
# DIVEHUB_LOG_LEVEL=info
# Optional, for importing dive sites: your e-mail or URL, sent in the User-Agent to Overpass and Wikidata.
# DIVEHUB_CONTACT=
# Optional: site sources this instance constructs and offers (default osm,wikidata,ssi). Leave osm out (wikidata,ssi)
# on a hosted instance that must not carry ODbL's derivative-database obligation (ADR 0087).
# DIVEHUB_SITE_SOURCES=osm,wikidata,ssi
# Optional, for sending dives to SSI: 32 bytes as base64 (openssl rand -base64 32). Lets Users keep their SSI password, encrypted.
# DIVEHUB_ENCRYPTION_KEY=
# Optional: Garmin's Personal API (default https://personal.connectapi.garmin.com); another endpoint only for tests.
# DIVEHUB_GARMIN_URL=
# Optional: push notifications for native clients (ADR 0085). Set BOTH or neither. Each value is JSON inline or a path
# to a JSON file. The service account is a secret and never ships; the client config is public and served by
# GET /api/push/config. Without them push is off and clients keep polling.
# DIVEHUB_FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}
# `applicationId` is the Firebase Android app's Google App ID (`1:...:android:...`), not the package name.
# DIVEHUB_FCM_CLIENT_CONFIG={"projectId":"...","applicationId":"1:1234567890:android:abcdef","apiKey":"...","gcmSenderId":"..."}
# Optional: transactional e-mail (hosted plan §6.1). Set all three or none. Without them, invitations and password
# reset links stay copy links (ADR 0012, 0013). Resend today; Postmark would be another provider behind the same module.
# The API key is a secret; the sender's domain must be verified at Resend.
# DIVEHUB_EMAIL_PROVIDER=resend
# DIVEHUB_EMAIL_API_KEY=re_...
# DIVEHUB_EMAIL_FROM=Dive Hub <noreply@dives.example.com>
